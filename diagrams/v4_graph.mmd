---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	chatbot(chatbot)
	herramientas(herramientas<hr/><small><em>ToolNode: buscar_eventos, consultar_pedido</em></small>)
	__end__([<p>__end__</p>]):::last
	__start__ --> chatbot;
	chatbot -.->|hay tool_calls| herramientas;
	chatbot -.->|no hay tool_calls| __end__;
	herramientas --> chatbot;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
