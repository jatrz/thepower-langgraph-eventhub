config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	clasificar(clasificar)
	responder_eventos(responder_eventos)
	responder_pedido(responder_pedido)
	responder_general(responder_general)
	__end__([<p>__end__</p>]):::last
	__start__ --> clasificar;
	clasificar -.-> responder_eventos;
	clasificar -.-> responder_general;
	clasificar -.-> responder_pedido;
	responder_eventos --> __end__;
	responder_general --> __end__;
	responder_pedido --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
